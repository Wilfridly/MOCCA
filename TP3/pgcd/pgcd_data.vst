      arg_p     : out     bit_vector(7 downto 0);
      wok_arg_p : in      bit;
      rd_res_p  : out     bit;
      res_p     : in      bit_vector(7 downto 0);
      rok_res_p : in      bit;
      ko_p      : out     bit;
      vdd       : in      bit;
      vss       : in      bit
 );
end pgcd_data;

