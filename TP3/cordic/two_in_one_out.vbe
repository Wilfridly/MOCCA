--
-- Generated by VASY
--
ENTITY two_in_one_out IS
PORT(
  ck	: IN BIT;
  raz	: IN BIT;
  nx_p	: IN BIT_VECTOR(7 DOWNTO 0);
  ny_p	: IN BIT_VECTOR(7 DOWNTO 0);
  rok_nxy_p	: IN BIT;
  rd_nxy_p	: OUT BIT;
  wok_axy_p	: IN BIT;
  wr_axy_p	: OUT BIT;
  data_out	: OUT BIT_VECTOR(7 DOWNTO 0);
  vdd	: IN BIT;
  vss	: IN BIT
);
END two_in_one_out;

ARCHITECTURE VBE OF two_in_one_out IS

  SIGNAL rtlsum_0	: BIT_VECTOR(0 DOWNTO 0);
  SIGNAL rtlcarry_0	: BIT_VECTOR(0 DOWNTO 0);
  SIGNAL rtl_internal_wr_axy_p	: BIT;
  SIGNAL rtldef_1	: BIT;
  SIGNAL rtldef_0	: BIT;
  SIGNAL n_send	: BIT;
  SIGNAL send	: REG_BIT REGISTER;
  SIGNAL n_wait0	: BIT;
  SIGNAL wait0	: REG_BIT REGISTER;
  SIGNAL counter	: REG_BIT REGISTER;
  SIGNAL n_counter	: BIT;
  SIGNAL fsm_def_4	: BIT;
BEGIN

  rtlcarry_0(0) <= '0';
  rtlsum_0(0) <= (NOT(counter) XOR rtlcarry_0(0));
  wr_axy_p <= rtl_internal_wr_axy_p;
  data_out <= nx_p WHEN ((counter = '0') AND rtl_internal_wr_axy_p) ELSE
     ny_p WHEN (counter AND rtl_internal_wr_axy_p) ELSE
     "00000000";
  LABEL0 : BLOCK  ((ck = '1') AND NOT(ck'STABLE) )
  BEGIN
    counter <= GUARDED n_counter;
  END BLOCK LABEL0;
  n_counter <= '0' WHEN wait0 ELSE
     rtlsum_0(0) WHEN send ELSE
     counter;
  rtl_internal_wr_axy_p <= send;
  rd_nxy_p <= wait0;
  LABEL1 : BLOCK  ((ck = '1') AND NOT(ck'STABLE) )
  BEGIN
    send <= GUARDED (rtldef_1 AND n_send);
  END BLOCK LABEL1;
  LABEL2 : BLOCK  ((ck = '1') AND NOT(ck'STABLE) )
  BEGIN
    wait0 <= GUARDED ((rtldef_0 AND n_wait0) OR fsm_def_4);
  END BLOCK LABEL2;
  rtldef_1 <= '1' WHEN NOT(fsm_def_4) ELSE
     '0';
  rtldef_0 <= '1' WHEN NOT(fsm_def_4) ELSE
     '0';
  fsm_def_4 <= (raz = '0');
  n_send <= ((send AND NOT(counter)) OR (wait0 AND rok_nxy_p));
  n_wait0 <= ((wait0 AND NOT(rok_nxy_p)) OR (send AND counter));
END VBE;
